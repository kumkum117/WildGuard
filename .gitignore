# Credentials — never commit this
.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/

# Model weights (large binary files)
*.pt
*.pth
*.onnx

# Database (auto-created at runtime)
wildguard_alerts.db

# Alerts/snapshots (runtime output). Anchored to the repo root: an unanchored
# "alerts/" also matched frontend/src/components/Alerts/ on case-insensitive
# file systems (Windows), which kept those components out of git.
/alerts/

# Server runtime data: uploaded media + analysis results, model caches,
# camera fleet / settings saved from the dashboard
data/analyses/
data/cache/
data/wildguard_config.json
data/sessions.json

# SQLite write-ahead files
*.db-wal
*.db-shm

# TypeScript incremental build info
*.tsbuildinfo

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db
