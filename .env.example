# -------------------------------------------------------
# WildGuard — environment config
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# -------------------------------------------------------

# ----- Email alert settings -----
# Gmail address that sends the alert
ALERT_EMAIL_FROM=you@gmail.com
# Gmail App Password (NOT your login password): https://myaccount.google.com/apppasswords
ALERT_EMAIL_PASSWORD=
# Address that receives the alert
ALERT_EMAIL_TO=ranger@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ----- Detection thresholds -----
ALERT_HIGH_RISK_ANIMALS=tiger,elephant,leopard,bear,lion,crocodile,wolf,cheetah,rhinoceros,hippopotamus
ALERT_CONFIDENCE_THRESHOLD=0.6
ALERT_COOLDOWN_SECONDS=300
# An alert stays open while its animal keeps being seen; after this many
# minutes without a sighting the next one starts a new alert.
WILDGUARD_INCIDENT_GAP_MIN=10

# ----- SMS: sign-in codes, ranger alerts, villager broadcasts -----
# Without SMS_PROVIDER the sign-in code is printed in the backend window.
# Pick ONE provider:
#   textbee       free; sends from your own Android phone (textbee.dev app)
#   smsgate       free; open-source "SMS Gateway for Android" app (sms-gate.app)
#   twilio_verify Twilio Verify (trial credit; trial can only text verified numbers)
#   twilio        Twilio SMS from your Twilio number
#   fast2sms      Fast2SMS (India, paid; OTP route — sign-in codes only)
SMS_PROVIDER=

# textbee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# smsgate (credentials are shown in the app's Cloud server section)
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# SMSGATE_BASE_URL=http://192.168.1.50:8080   # local-server mode

# twilio / twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# fast2sms
FAST2SMS_API_KEY=

# Numbers (comma-separated; 10-digit Indian numbers get +91 automatically)
# Rangers texted on new high-risk alerts and escalations (needs a provider
# that can send free text: textbee, smsgate or twilio):
ALERT_SMS_TO=
# Villagers who receive broadcasts from the Deterrence page:
VILLAGER_SMS_TO=

# ----- Sign-in -----
# Only these numbers may sign in (name and role optional). Empty = anyone.
# WILDGUARD_USERS=+919876543210:Sania:admin, 9812345678:Ravi
WILDGUARD_DEFAULT_COUNTRY_CODE=91
# The demo code 123456 works only while no SMS provider is set. Set this to
# force a code, or leave it empty to disable the demo code entirely.
# WILDGUARD_DEMO_OTP=
WILDGUARD_SESSION_DAYS=7

# ----- Deterrence hardware -----
# Every siren/light/broadcast change is POSTed here as JSON (relay board, ESP32, PA system).
DETERRENCE_WEBHOOK_URL=

# ----- Server -----
# WILDGUARD_MODEL=models/yolov8s-worldv2.pt
# WILDGUARD_HOST=127.0.0.1
# WILDGUARD_PORT=5000
# WILDGUARD_REQUIRE_AUTH=1
